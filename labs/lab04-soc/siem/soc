#!/usr/bin/env python3
"""soc: tiny query CLI for the SIEM. Usage: soc alerts | soc events [--type T] | soc rules"""
import glob
import json
import sys

import yaml

A, E = "/opt/soc/alerts.jsonl", "/opt/soc/events.jsonl"


def load(path):
    try:
        return [json.loads(x) for x in open(path) if x.strip()]
    except FileNotFoundError:
        return []


cmd = sys.argv[1] if len(sys.argv) > 1 else "alerts"
if cmd == "alerts":
    for a in load(A)[-60:]:
        print(f"{a['detected_at']}  [{a['level'].upper():6}] {a['title']:28} "
              f"src={a.get('source_ip') or '-':15} user={a.get('user') or '-':10} "
              f"{','.join(a.get('mitre', []))}  ({a['rule_id']}/{a['source']})")
elif cmd == "events":
    ev = load(E)
    if "--type" in sys.argv:
        t = sys.argv[sys.argv.index("--type") + 1]
        ev = [e for e in ev if e["event_type"] == t]
    for e in ev[-80:]:
        print(f"{e['time']}  {e['event_type']:16} ip={e.get('source_ip') or '-':15} "
              f"user={e.get('user') or '-':10} {e.get('command') or ''}")
    print(f"--- {len(ev)} event(s)")
elif cmd == "rules":
    for d in ("builtin", "custom"):
        for p in sorted(glob.glob(f"/opt/soc/rules/{d}/*.yml") + glob.glob(f"/opt/soc/rules/{d}/*.yaml")):
            try:
                r = yaml.safe_load(open(p))
                print(f"[{d}] {r.get('id'):8} {r.get('title'):30} "
                      f"match={r.get('match')} threshold={r.get('threshold')}")
            except Exception as ex:
                print(f"[{d}] {p}: PARSE ERROR {ex}")
else:
    print(__doc__)
